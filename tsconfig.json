// ESM Module Configuration for TypeScript
// This is the main configuration file used for building ES modules (ESM) output.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist/esm",
    "declarationDir": "./dist/esm/types",
    "allowImportingTsExtensions": false
  }
}
